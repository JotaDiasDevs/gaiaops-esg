# =============================================================================
# Ambiente PRODUCAO - configuracao NAO sensivel
#
# Lido pelo docker compose (--env-file) e pelos scripts deploy.sh e
# smoke-test.sh. As senhas NAO ficam aqui: vem dos GitHub Secrets do ambiente
# "production" ou sao geradas pelo deploy.sh (veja o README).
#
# Diferencas para staging: perfil "prod" (sem Swagger, health sem detalhes,
# log em INFO), porta 8082 e mais memoria para a API.
# =============================================================================
APP_PORT=8082
SPRING_PROFILES_ACTIVE=prod
GAIAOPS_AMBIENTE=producao
GAIAOPS_SEED_ENABLED=true
API_MEMORY_LIMIT=1g
MONGO_DATABASE=gaiaops_esg
MONGO_ROOT_USER=admin
MONGO_APP_USER=gaiaops_app
