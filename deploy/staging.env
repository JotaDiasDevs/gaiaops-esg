# =============================================================================
# Ambiente STAGING (homologacao) - configuracao NAO sensivel
#
# Lido pelo docker compose (--env-file) e pelos scripts deploy.sh e
# smoke-test.sh. As senhas NAO ficam aqui: vem dos GitHub Secrets do ambiente
# "staging" ou sao geradas pelo deploy.sh (veja o README).
# =============================================================================
APP_PORT=8081
SPRING_PROFILES_ACTIVE=staging
GAIAOPS_AMBIENTE=staging
GAIAOPS_SEED_ENABLED=true
API_MEMORY_LIMIT=768m
MONGO_DATABASE=gaiaops_esg
MONGO_ROOT_USER=admin
MONGO_APP_USER=gaiaops_app
