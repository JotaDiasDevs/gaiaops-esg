# =============================================================================
# GaiaOps ESG - variaveis de ambiente para execucao LOCAL com Docker Compose
#
#   1. copie este arquivo:   cp .env.example .env
#   2. troque as senhas
#   3. suba:                  docker compose up -d --build
#
# O .env real esta no .gitignore e nunca deve ser versionado.
# Use apenas letras e numeros nas senhas (elas entram na URI de conexao).
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
# Porta publicada no host:  http://localhost:8080
APP_PORT=8080
# Perfil Spring: local | staging | prod
SPRING_PROFILES_ACTIVE=local
# Nome exibido na pagina inicial e em /actuator/info: local | staging | producao
GAIAOPS_AMBIENTE=local
# Carga inicial com os 100 documentos da Fase 5 (so popula collections vazias)
GAIAOPS_SEED_ENABLED=true
# Imagem da API. Localmente e construida a partir do Dockerfile.
API_IMAGE=gaiaops-esg-api:local
API_MEMORY_LIMIT=768m

# --- MongoDB -----------------------------------------------------------------
MONGO_DATABASE=gaiaops_esg
# Administrador do MongoDB (nao e usado pela aplicacao)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=TroqueEstaSenhaRoot123
# Usuario da aplicacao: leitura/escrita apenas no banco MONGO_DATABASE
MONGO_APP_USER=gaiaops_app
MONGO_APP_PASSWORD=TroqueEstaSenhaApp123
