# Scripts que rodam no Linux (runners do GitHub e containers) precisam de LF,
# mesmo quando o repositorio e editado no Windows.
*.sh     text eol=lf
mvnw     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env    text eol=lf
*.js     text eol=lf
*.py     text eol=lf
Dockerfile text eol=lf

# Scripts do Windows
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binarios
*.png    binary
*.jpg    binary
*.pdf    binary
*.docx   binary
*.pptx   binary
*.jar    binary
